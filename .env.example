# --- Local development (npm run dev) ---

# Where the Vite dev server proxies /api and /uploads.
DEV_API_TARGET=http://localhost:3000


# --- Deploy (docker-compose.yml) ---
# Copy to .env next to the compose file and fill in per environment.

# Docker Hub images. Tag = environment or version.
BACKEND_IMAGE=<org>/stage-drive-backend:develop
FRONTEND_IMAGE=<org>/stage-drive-frontend:develop

# Public app URL. Backend builds Google OAuth redirects from it,
# so it must match Google Cloud Console.
PUBLIC_URL=http://localhost

# Host port for the frontend nginx.
HTTP_PORT=80

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=stage_drive

AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
