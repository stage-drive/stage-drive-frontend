# Rendered by the nginx image's envsubst at container start.
# DNS_RESOLVER: 127.0.0.11 is Docker's embedded DNS (compose).
# Use a public resolver (e.g. 8.8.8.8) when the backend is outside compose.
resolver ${DNS_RESOLVER} valid=30s ipv6=off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Backend caps images at 2MB; leave room for multipart overhead.
    client_max_body_size 4m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;

    # Variable in proxy_pass forces runtime DNS re-resolution, which matters
    # for managed backends (Cloud Run) whose addresses rotate.
    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;

        # Cloud Run routes by Host header and needs SNI.
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;

        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend-served uploads; DB stores paths like /uploads/avatars/<id>.png.
    location /uploads/ {
        set $backend_uploads "${BACKEND_URL}";
        proxy_pass $backend_uploads;

        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;

        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite asset filenames are hashed.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA fallback for react-router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
